# Public hostname pointing at this server (DNS A record). Caddy gets the certificate.
DOMAIN=commander.example.com

# SHA-256 of your access token. Generate both with:
#   TOKEN=$(openssl rand -base64 32 | tr -d '=+/' ); echo "token: $TOKEN"
#   printf %s "$TOKEN" | shasum -a 256 | cut -d' ' -f1
IMALI_MCP_TOKEN_SHA256=

# Your IMALI Commander Pro license key (remote access is a Pro feature).
IMALI_LICENSE_KEY=

# Folder on this server the assistant may use.
IMALI_WORKSPACE_DIR=./workspace

# 1 = assistants can read but not change files.
IMALI_READ_ONLY=0
IMALI_MAX_SESSIONS=16
